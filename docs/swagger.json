            "properties": {
                "refresh_token": {
                    "type": "string"
                }
            }
        },
        "user.PaginationResponse": {
            "type": "object",
            "properties": {
                "page": {
                    "type": "integer"
                },
                "page_size": {
                    "type": "integer"
