APP_NAME=ars-kit
APP_ENV=production
PORT=8181

DB_HOST=localhost
DB_PORT=5432
DB_USER=wrgsktr
DB_PASS=P@ssw0rdPostgre
DB_NAME=ars_kit
# DB_SCHEMA=public (optional, defaults to public if not set)

# Workflow engine (PostgreSQL-backed background jobs)
WORKFLOW_WORKERS=3
# poll interval in seconds (also the de facto retry delay)
WORKFLOW_POLL_INTERVAL=5
# minutes; must exceed BatchSize x slowest step (drain window)
WORKFLOW_STALE_TIMEOUT=3
# seconds; how long shutdown waits for in-flight steps
WORKFLOW_DRAIN_TIMEOUT=30
# jobs claimed per poll
WORKFLOW_BATCH_SIZE=5
# seconds; per-step execution timeout — a step that exceeds it is cancelled
# and retried/failed (must be smaller than WORKFLOW_STALE_TIMEOUT)
WORKFLOW_STEP_TIMEOUT=60

# Per-account login throttling / lockout
# Consecutive failed logins before the account locks (default: 5)
LOGIN_MAX_FAILED_ATTEMPTS=5
# Counting window in minutes: failures older than this reset the counter (default: 15)
LOGIN_FAILED_WINDOW_MINUTES=15
# Lock duration in minutes after reaching the failed-attempt threshold (default: 15)
LOGIN_LOCKOUT_MINUTES=15

JWT_SECRET=nduP2LZZ1KFjlejfUuoNyQP3Jz2o5XUJ

# CORS Configuration - IMPORTANT: Set this to your frontend domain
# For production: https://yourdomain.com
# For development: http://localhost:3000
# DO NOT USE * (wildcard) - it's a security risk!
CORS_ALLOW_ORIGIN=http://localhost:3000

# Email notification (foundation module)
# Provider: smtp (default), resend, brevo
EMAIL_PROVIDER=smtp
# SMTP (used when EMAIL_PROVIDER=smtp) - Gmail app password required
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_app@gmail.com
SMTP_PASSWORD=your_gmail_app_password
SMTP_FROM=noreply@yourdomain.com
# Resend (used when EMAIL_PROVIDER=resend)
RESEND_API_KEY=
RESEND_FROM=noreply@yourdomain.com
# Brevo (used when EMAIL_PROVIDER=brevo)
BREVO_API_KEY=
BREVO_FROM=noreply@yourdomain.com
