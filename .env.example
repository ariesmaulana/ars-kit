APP_NAME=ars-kit
APP_ENV=production
PORT=8181

DB_HOST=localhost
DB_PORT=5432
DB_USER=wrgsktr
DB_PASS=P@ssw0rdPostgre
DB_NAME=ars_kit
# DB_SCHEMA=public (optional, defaults to public if not set)

# Workflow engine (PostgreSQL-backed background jobs)
WORKFLOW_WORKERS=3
# poll interval in seconds (also the de facto retry delay)
WORKFLOW_POLL_INTERVAL=5
# minutes; must exceed BatchSize x slowest step (drain window)
WORKFLOW_STALE_TIMEOUT=3
# seconds; how long shutdown waits for in-flight steps
WORKFLOW_DRAIN_TIMEOUT=30
# jobs claimed per poll
WORKFLOW_BATCH_SIZE=5

JWT_SECRET=nduP2LZZ1KFjlejfUuoNyQP3Jz2o5XUJ

# CORS Configuration - IMPORTANT: Set this to your frontend domain
# For production: https://yourdomain.com
# For development: http://localhost:3000
# DO NOT USE * (wildcard) - it's a security risk!
CORS_ALLOW_ORIGIN=http://localhost:3000
